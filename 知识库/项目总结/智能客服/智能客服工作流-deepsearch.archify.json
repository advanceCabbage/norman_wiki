  "edges": [
    { "id": "query-intent", "from": "query", "to": "intent", "role": "main" },
    { "id": "intent-retrieve", "from": "intent", "to": "retrieve", "label": "知识库（始终）", "role": "main" },
    { "id": "intent-validate", "from": "intent", "to": "validate", "label": "deepSearch=是", "role": "branch", "variant": "dashed" },
    { "id": "validate-clarify", "from": "validate", "to": "clarify", "label": "信息不足", "role": "error", "variant": "security" },
    { "id": "validate-code", "from": "validate", "to": "code", "label": "信息完整", "role": "main" },
    { "id": "retrieve-rrf", "from": "retrieve", "to": "rrf", "label": "40 个候选", "role": "main" },
    { "id": "rrf-reply", "from": "rrf", "to": "reply", "label": "Top-20 片段", "role": "main", "fromSide": "right", "toSide": "right", "route": "outside-right", "labelAt": [692, 405] },
    { "id": "code-reply", "from": "code", "to": "reply", "label": "源码结论", "role": "async", "variant": "dashed", "fromSide": "right", "toSide": "right", "route": "outside-right", "channelX": 720, "labelAt": [750, 285] },
    { "id": "update-retrieve", "from": "update", "to": "retrieve", "label": "更新索引", "role": "return", "variant": "dashed" }
